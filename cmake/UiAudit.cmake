# mu_add_ui_audit(<product-target> <product-dir>): <product-target>-ui-audit, a console app that builds the product's REAL processor and
# editor from the product's own sources and checks that every control it can change reports to the status bar (the hard rule; see
# mu-core/Tests/UiAudit/UiAuditMain.cpp). On demand (EXCLUDE_FROM_ALL). Call after the product's directory has been added.
function(mu_add_ui_audit product dir)
    set(audit ${product}-ui-audit)
    get_target_property(raw ${product} SOURCES)
    set(sources "")
    foreach(src ${raw})
        get_filename_component(abs "${src}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}/${dir}")
        list(APPEND sources "${abs}")
    endforeach()
    juce_add_console_app(${audit} PRODUCT_NAME "${audit}")
    target_sources(${audit} PRIVATE ${sources} "${CMAKE_SOURCE_DIR}/mu-core/Tests/UiAudit/UiAuditMain.cpp")
    get_target_property(incs ${product} INCLUDE_DIRECTORIES)
    if(incs)
        target_include_directories(${audit} PRIVATE ${incs})
    endif()
    get_target_property(defs ${product} COMPILE_DEFINITIONS)
    if(defs)
        # juce_add_console_app sets JUCE_STANDALONE_APPLICATION itself; copying the product's value too redefines it (RC4005).
        list(FILTER defs EXCLUDE REGEX "^JUCE_STANDALONE_APPLICATION")
        target_compile_definitions(${audit} PRIVATE ${defs})
    endif()
    get_target_property(libs ${product} LINK_LIBRARIES)
    if(libs)
        list(FILTER libs EXCLUDE REGEX "_SharedCode|plugin_client|juce_audio_plugin")
        target_link_libraries(${audit} PRIVATE ${libs})
    endif()
    target_compile_definitions(${audit} PRIVATE JUCE_MODAL_LOOPS_PERMITTED=1)
    if("SLOT_HOST" IN_LIST ARGN)
        # a host of engines (mu-Tronic, mu-Host): each engine is audited in turn (see UiAuditMain.cpp)
        target_compile_definitions(${audit} PRIVATE UIAUDIT_SLOT_HOST=1)
    endif()
    set_target_properties(${audit} PROPERTIES EXCLUDE_FROM_ALL TRUE)
endfunction()
